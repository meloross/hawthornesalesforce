<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>HFS Lead Routing</fullName>
        <active>true</active>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.TCPA_Scrub_Status__c</field>
                <operation>equals</operation>
                <value>Do Not Contact,Flagged</value>
            </criteriaItems>
            <assignedTo>Compliance_Hold</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.Office__c</field>
                <operation>equals</operation>
                <value>HFS_TPA</value>
            </criteriaItems>
            <assignedTo>Tampa_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.Office__c</field>
                <operation>equals</operation>
                <value>HFS_MIA</value>
            </criteriaItems>
            <assignedTo>Miami_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.Office__c</field>
                <operation>equals</operation>
                <value>HFS_NJ</value>
            </criteriaItems>
            <assignedTo>New_Jersey_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.Office__c</field>
                <operation>equals</operation>
                <value>HFS_NY</value>
            </criteriaItems>
            <assignedTo>New_York_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
        <ruleEntry>
            <formula>true</formula>
            <assignedTo>Unassigned_Overflow</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
