<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>HFS Lead Routing</fullName>
        <active>true</active>
        <!-- Compliance hold: any not-yet-Clear lead (Pending/Flagged/Do Not Contact/Error) stays held. Safety first. -->
        <ruleEntry>
            <criteriaItems>
                <field>Lead.TCPA_Scrub_Status__c</field>
                <operation>equals</operation>
                <value>Pending,Flagged,Do Not Contact,Error</value>
            </criteriaItems>
            <assignedTo>Compliance_Hold</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
        <!-- Everything else (Clear, not yet office-assigned) lands in the pool. LeadDistributionBatch is the ONLY thing that sets Office__c. -->
        <ruleEntry>
            <formula>true</formula>
            <assignedTo>HFS_Lead_Pool</assignedTo>
            <assignedToType>Queue</assignedToType>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
