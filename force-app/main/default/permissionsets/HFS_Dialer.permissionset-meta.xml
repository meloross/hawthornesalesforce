<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>HFS Dialer</label>
    <description>Outbound dialer list-gate access: Dial_List_Entry__c CRUD + FLS, and read on Lead.Dialer_Eligible__c. Assign to admins and the campaign-export identity. The DialListRefresh batch itself runs in system context and does not require this.</description>
